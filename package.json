{
  "name": "codeo",
  "version": "1.0.0",
  "description": "CODEO - Real-time Collaborative Code Editor & Development Studio",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "preview": "npm --prefix frontend run preview",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "db:verify": "npm --prefix backend run db:verify",
    "test:auth": "npm --prefix backend run test:auth",
    "test:live": "npm --prefix backend run test:live",
    "test:rooms": "npm --prefix backend run test:rooms",
    "test:sync": "npm --prefix backend run test:sync",
    "test:execute": "npm --prefix backend run test:execute",
    "test:collab": "npm --prefix backend run test:collab"
  },
  "keywords": [
    "collaborative-editor",
    "monaco",
    "yjs",
    "socketio",
    "supabase",
    "codeo"
  ],
  "license": "ISC"
}