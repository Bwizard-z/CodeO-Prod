# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origins for CORS (Comma-separated for multiple domains)
CLIENT_URL=http://localhost:5173
# FRONTEND_URL=https://your-frontend-domain.vercel.app

# Supabase (Database & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Code Execution (Judge0)
# Self-hosted: http://localhost:2358/api/v1 or https://judge0.yourdomain.com
# RapidAPI: https://judge0-ce.p.rapidapi.com
JUDGE0_URL=http://localhost:2358/api/v1
# Optional: Judge0 Auth Token (if self-hosted with token)
# JUDGE0_API_KEY=
# Optional: RapidAPI Key (if using RapidAPI Judge0)
# RAPIDAPI_KEY=

# Google Gemini AI (Explain & AI Assistant)
GEMINI_API_KEY=your-gemini-api-key

# Agora Voice & Video Chat
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
